{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Bash(bws:*)",
      "Read(./user_data/data/**)",
      "Read(./user_data/backtest_results/**)",
      "Read(./user_data/logs/**)",
      "Read(./**/*.sqlite)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/live-gate.sh" }
        ]
      }
    ]
  }
}
