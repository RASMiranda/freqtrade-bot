# Copy to .env (never committed; ./setup.sh does it for you at mode 600).
# Non-secret FREQTRADE__* overrides live here.
#
# Secrets (API password, JWT secret, exchange keys, tokens):
#   SECRETS_BACKEND=bws  they live in Bitwarden Secrets Manager; setup.sh prints
#                        the generated ones once for you to save, nothing is stored here.
#   SECRETS_BACKEND=env  setup.sh writes the generated API password and JWT
#                        secret to this file (mode 600). Do not commit or paste it.

# env = run docker compose directly, bws = run it through `bws run` (used by ./bot)
SECRETS_BACKEND=env

# Exchange. Kraken is the default; Binance blocks some countries (incl. the US).
FREQTRADE__EXCHANGE__NAME=kraken

# Dry-run wallet and open-trade limit. The wallet is 50 because the go-live stake is EUR 50.
FREQTRADE__DRY_RUN_WALLET=50
FREQTRADE__MAX_OPEN_TRADES=3

# API user (the password and JWT secret are secrets, set them via bws/env)
FREQTRADE__API_SERVER__USERNAME=freqtrader

# HC_PING_URL (healthchecks.io ping URL used by scripts/heartbeat.sh) is not set
# here: set it through bws or the environment.
