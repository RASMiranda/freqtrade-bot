# Copy to .env (never committed). Non-secret FREQTRADE__* overrides only.
# Secrets (API password, JWT secret, exchange keys, tokens) live in Bitwarden
# Secrets Manager when SECRETS_BACKEND=bws; with env they go in your shell
# environment, not in this file.

# env = run docker compose directly, bws = run it through `bws run` (used by ./bot)
SECRETS_BACKEND=env

# Exchange. Kraken is the default; Binance blocks some countries (incl. the US).
FREQTRADE__EXCHANGE__NAME=kraken

# Dry-run wallet and open-trade limit
FREQTRADE__DRY_RUN_WALLET=1000
FREQTRADE__MAX_OPEN_TRADES=3

# API user (the password and JWT secret are secrets, set them via bws/env)
FREQTRADE__API_SERVER__USERNAME=freqtrader

# Optional: healthchecks.io ping URL used by scripts/heartbeat.sh
HC_PING_URL=
